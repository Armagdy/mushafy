<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic for all domains (for API access) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Specific domains that your app connects to -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">everyayah.com</domain>
        <domain includeSubdomains="true">mp3quran.net</domain>
        <domain includeSubdomains="true">api.alquran.cloud</domain>
        <domain includeSubdomains="true">api.quran.com</domain>
    </domain-config>
</network-security-config>
